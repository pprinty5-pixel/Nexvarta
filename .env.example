# ==========================================
# NEXVARTA ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Razorpay Payment Gateway (Optional for live payments, sandbox simulator active by default)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 2. Cloud Video Storage (AWS S3 / Cloudflare R2 / MinIO)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nexvarta-videos

# 3. Base Portal URL
NEXT_PUBLIC_SITE_URL=https://nexvarta.com
